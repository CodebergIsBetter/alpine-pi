# Single source of truth for what goes into the images.
#
# These credentials are deliberately trivial and are published with every
# release, so treat any device built from a release image as untrusted until
# you change them. Change the password on first login, and put your own Wi-Fi
# details in by editing wpa_supplicant.conf on the FAT boot partition (visible
# from any computer with an SD card reader) rather than reflashing.
ALPINEPI_DEVICE=raspberry-pi0

ALPINEPI_HOSTNAME=alpinepi
ALPINEPI_USER=alpinepi
ALPINEPI_PASSWORD=alpinepi

ALPINEPI_WIFI_SSID=alpinepi
# WPA2 requires 8..63 characters. "alpinepi" is exactly 8, so it is the
# shortest passphrase that is legal here; anything shorter is rejected by
# wpa_passphrase, not by us.
ALPINEPI_WIFI_PSK=alpinepi

# The regulatory domain, and the one value here that is OPTIONAL: leave it
# empty and no country= line is written, which leaves the card in the world
# domain. That is the trade-off, and it is a real one for a board that has to
# associate to an unknown AP:
#   US    channels 1-11 on 2.4 GHz and a transmit mask that is legal
#         everywhere in North America
#   empty the world domain - channels 1-13 are scanned passively, so an AP on
#         12 or 13 is found at all, but the card will not transmit until it has
#         heard a beacon
# Anything else must be a two letter ISO 3166-1 code; pmbootstrap rejects the
# conventional "00" world-domain literal, which is why empty is the way to ask
# for it. This only affects NEWLY BUILT images - a board already flashed is
# changed by editing country= in /boot/wpa_supplicant.conf on the FAT
# partition, from any computer with an SD card reader.
ALPINEPI_WIFI_COUNTRY=US

ALPINEPI_TIMEZONE=America/Los_Angeles
ALPINEPI_LOCALE=en_US.UTF-8

# Extra megabytes on the root filesystem. 1024 leaves enough slack for an
# "apk upgrade" that unpacks something large (llvm-libs is ~170 MB) without
# resizing first.
ALPINEPI_EXTRA_SPACE=1024

# The forks that carry deviceinfo_alpine_only and the device/alpine port.
ALPINEPI_PMBOOTSTRAP_REPO=https://github.com/CodebergIsBetter/pmbootstrap.git
ALPINEPI_PMAPORTS_REPO=https://github.com/CodebergIsBetter/pmaports.git
ALPINEPI_BRANCH=rpi-zero-w-alpine-only
